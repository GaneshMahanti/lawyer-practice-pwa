# ==============================================================================
# VakilDesk PWA Environment Configuration Template
# DO NOT COMMIT PRIVATE CREDENTIALS TO GIT.
# ==============================================================================

# Supabase Public Configuration (Safe for browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Server-Only Configuration (Never expose to browser)
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Razorpay Configuration (Server-Only credentials)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Voice Diary Speech-to-Text (Server-Only credentials)
OPENAI_API_KEY=your_openai_api_key
TRANSCRIPTION_MODEL=whisper-1

# WhatsApp BSP Provider Configuration (Server-Only credentials)
WHATSAPP_BSP_PROVIDER=mock
WHATSAPP_API_KEY=your_whatsapp_bsp_api_key
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hearing notifications (Web Push). Generate the key pair once with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe for the browser; VAPID_PRIVATE_KEY is SERVER-ONLY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the scheduler sends to /api/cron/reminders (use a long random string, SERVER-ONLY)
CRON_SECRET=generate-a-long-random-string
